# ==============================================================================
# Generic Root-Level .gitignore for Common Development Environments
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
[Dd]esktop.ini

# Linux
*~

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / JetBrains (WebStorm, PyCharm, etc)
.idea/
*.iml
*.iws

# Eclipse
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders

# Sublime Text
*.sublime-workspace

# Vim
.*.sw[a-p]
*.un~

# Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate

# ------------------------------------------------------------------------------
# Node.js
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log
yarn-error.log
yarn-debug.log
.pnpm-debug.log
pnpm-debug.log
.yarn/
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
dist/
build/
out/
.nuxt/
.next/
coverage/
.cache/

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
celerybeat-schedule

# ------------------------------------------------------------------------------
# Java / Kotlin
# ------------------------------------------------------------------------------
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# C / C++
# ------------------------------------------------------------------------------
*.o
*.obj
*.out
*.app
*.i
*.s
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.com
*.class
*.pyc

# ------------------------------------------------------------------------------
# Go
# ------------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ------------------------------------------------------------------------------
# Rust
# ------------------------------------------------------------------------------
/target/
**/*.rs.bk

# ------------------------------------------------------------------------------
# Logs & Databases
# ------------------------------------------------------------------------------
*.sqlite
*.db
*.sqlite3

# ------------------------------------------------------------------------------
# Environments & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.p12

# ------------------------------------------------------------------------------
# Android
# ------------------------------------------------------------------------------
# Built application files
*.apk
*.ap_
*.aab

# local configuration file (sdk path, etc)
local.properties

# NDK
obj/

# ------------------------------------------------------------------------------
# Other generic files
# ------------------------------------------------------------------------------
*.bak
*.swp
*~
*.swx
.DS_Store
